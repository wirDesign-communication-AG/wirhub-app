# Keeps the build context small and makes a local build produce the same
# content as the fresh checkout on CI.
#
# auth.json is deliberately excluded: the credentials reach the build as a
# BuildKit secret, so nothing may carry them in through the context.

.git
auth.json
.github
.idea/

# Created inside the image by composer install --no-dev
vendor/

# Runtime and user data (several GB locally)
var/
files/*
!files/.gitkeep

# Must not end up as an empty directory in the image: start.sh creates a
# symlink here via "ln -s /opt/wirhub-secret/ secret".
secret

# Created at runtime by assets:install / start.sh
public/asset
public/file
public/app
public/bundles/

node_modules/
build/node_modules
build/debug

.env.local
.env.local.php
.env.*.local
.phpunit.cache/
.phpunit.result.cache
.php-cs-fixer.cache
